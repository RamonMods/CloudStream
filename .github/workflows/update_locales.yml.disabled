name: Corrigir problemas de locale

on:
  push:
    branches: [ master ]
    paths:
      - '**.xml'
  workflow_dispatch:

concurrency:
  group: "locale"
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  create:
    runs-on: ubuntu-latest
    steps:
    - name: Gerar token de acesso
      id: generate_token
      uses: tibdex/github-app-token@v2
      with:
        app_id: ${{ secrets.GH_APP_ID }}
        private_key: ${{ secrets.GH_APP_KEY }}
        repository: "RamonMods/CloudStream"

    - uses: actions/checkout@v6
      with:
        token: ${{ steps.generate_token.outputs.token }}

    - name: Instalar dependências
      run: pip3 install lxml requests

    - name: Editar arquivos
      run: python3 .github/locales.py

    - name: Commitar no repositório
      run: |
        git config --local user.email "RamonMods[bot]@users.noreply.github.com"
        git config --local user.name "RamonMods[bot]"
        git add .
        # "echo" retorna sucesso para o build não falhar quando não houver mudanças
        git commit -m 'chore(locales): corrige problemas de locale' || echo
        git push
